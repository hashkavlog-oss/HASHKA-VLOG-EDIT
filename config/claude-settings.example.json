{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70",
    "BASH_MAX_OUTPUT_LENGTH": "15000"
  },
  "permissions": {
    "allow": [
      "Bash(python3 scripts/edit.py:*)",
      "Bash(ffprobe:*)",
      "Bash(ffmpeg:*)",
      "Bash(npx remotion:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Read(./node_modules/**)",
      "Read(./remotion/node_modules/**)",
      "Read(./remotion/package-lock.json)",
      "Read(./remotion/public/fonts/**)",
      "Read(./input/**)",
      "Read(./output/**)",
      "Read(./work/**/*.wav)",
      "Read(./work/**/*.mp4)",
      "Read(./work/**/cut_filter.txt)"
    ]
  }
}
